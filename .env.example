# Copy this file to .env and fill in the blank credentials.
# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Public browser image delivery/upload settings
VITE_CLOUDINARY_CLOUD_NAME=a5bi1hsj
VITE_CLOUDINARY_UNSIGNED_UPLOAD_PRESET=sarifi_demo_products
# Current local/demo checkout configuration.
VITE_ALLOW_DEMO_CHECKOUT=true
VITE_USE_TRUSTED_CHECKOUT=false
VITE_FUNCTIONS_REGION=asia-southeast1
# Private Node tooling, also loaded from .env. Never prefix these with VITE_.
CLOUDINARY_CLOUD_NAME=a5bi1hsj
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional alternative to the Cloudinary credential fields above.
CLOUDINARY_URL=
GOOGLE_APPLICATION_CREDENTIALS=
SARIFI_ADMIN_TARGETS=
